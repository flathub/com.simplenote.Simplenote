<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.simplenote.Simplenote</id>
  
  <name>Simplenote</name>
  <summary>The simplest way to keep notes</summary>
  
  <developer_name>Automattic Inc.</developer_name>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>

  <url type="homepage">https://simplenote.com</url>
  <url type="vcs-browser">https://github.com/Automattic/simplenote-electron</url>
  <url type="bugtracker">https://github.com/Automattic/simplenote-electron/issues</url>
  <url type="help">https://simplenote.com/help/</url>
  
  <description>
    <p>
      Simplenote allows you to keep your notes updated across all your devices.
      You can organize your notes with custom tags to quickly search for your
      content. With Simplenote, you can share a note for collaboration or publish
      your notes online. Simplenote also has Markdown support, which allows you
      to preview and publish your notes in Markdown format.
    </p>
  </description>

  <launchable type="desktop-id">com.simplenote.Simplenote.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/flathub/com.simplenote.Simplenote/raw/master/screenshots/simplenote1.png</image>
      <caption>Main interface of Simplenote</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/flathub/com.simplenote.Simplenote/raw/master/screenshots/simplenote2.png</image>
      <caption>Tagging and organizing notes</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/flathub/com.simplenote.Simplenote/raw/master/screenshots/simplenote3.png</image>
      <caption>Markdown preview mode</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1">
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>
  
  <releases>
    <release date="2025-11-20" version="2.24.0">
      <description>
        <p>This release introduces new features and important fixes:</p>
        <ul>
          <li>Implemented support for importing notes from ZIP files.</li>
          <li>Fixed an issue where paste was not working in the context menu.</li>
          <li>Enabled paste functionality in browsers.</li>
          <li>General stability improvements and internal dependency updates.</li>
        </ul>
      </description>
    </release>
    <release date="2021-10-18" version="2.21.0" /> 
    <release date="2021-10-04" version="2.20.0" />
    <release date="2021-09-21" version="2.19.1" />
    <release date="2021-09-20" version="2.19.0" />
  </releases>
</component>
